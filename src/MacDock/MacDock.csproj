<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MacDock</AssemblyName>
    <RootNamespace>MacDock</RootNamespace>
    <StartupObject>MacDock.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MacDock.ico</ApplicationIcon>
    <Version>0.3.1</Version>
    <FileVersion>0.3.1.0</FileVersion>
    <Product>MacDock</Product>
    <Company>MacDock</Company>
    <Description>MacDock - giao diện kiểu macOS cho Windows 11</Description>
    <Copyright>MIT License</Copyright>
    <!-- Giảm RAM: GC workstation, không GC nền -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en;vi</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MacDock.ico" />
    <Resource Include="Assets\dat.jpeg" />
    <Resource Include="Assets\qr.jpeg" />
  </ItemGroup>

</Project>
